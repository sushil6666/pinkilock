{
  "expo": {
    "name": "Pinkilock",
    "slug": "pinkilock",
    "owner": "pinkilock",
    "scheme": "pinkilock",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#241A63",
    "ios": {
      "bundleIdentifier": "com.pinkilock.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.pinkilock.app",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS", "android.permission.BLUETOOTH_CONNECT"],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#241A63"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#241A63",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "themeColor": "#241A63",
      "backgroundColor": "#241A63",
      "description": "One person. One tiny plan. One pinky promise that you both show up."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#241A63",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6FAE",
          "defaultChannel": "promises"
        }
      ],
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pinkilock uses a photo you pick for your profile, shown only after a kept promise.",
          "cameraPermission": false,
          "microphonePermission": "Pinkilock uses the microphone only during a voice call you join. Calls are audio only and never recorded."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pinkilock uses the front camera to take the photo of your face shown on your card.",
          "microphonePermission": "Pinkilock uses the microphone only during a voice call you join. Calls are audio only and never recorded.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pinkilock uses your location once, on this phone, to suggest your city and nearest area. It is never saved or sent."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "1bafeacf-67dd-44df-8cf4-6f46e78955ef"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1bafeacf-67dd-44df-8cf4-6f46e78955ef"
    }
  }
}
