# Response headers for the website on Cloudflare Pages. Copied into the build by
# .github/workflows/web-deploy.yml, which replaces SUPABASE_HOST with the project the build talks to.
#
# The page holds the sign-in session in the browser, so it runs no script but its own: no inline
# script, no eval, nothing from another origin except Cloudflare's captcha (Turnstile, D091: its
# script and its frame, and only when the build has a site key). Styles may be inline because
# react-native-web writes its styles into the page. The only other place the page may talk to is
# Supabase (HTTPS for the API, WSS for Realtime), and the only other images it shows are photos
# from Supabase Storage's ten-minute signed links (D088). Razorpay Checkout (D104, wallet top-ups) may
# load its script, frame and images and talk to its API; UPI and bank pages it opens need popups,
# so the opener policy allows them. Of the browser's powers, only the location may be asked for,
# and only by the site itself, for "Use my location" (D087), and payment, by Razorpay's frame.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://checkout.razorpay.com; frame-src https://challenges.cloudflare.com https://api.razorpay.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://SUPABASE_HOST https://cdn.razorpay.com; font-src 'self' data:; connect-src 'self' https://SUPABASE_HOST wss://SUPABASE_HOST https://api.razorpay.com https://lumberjack.razorpay.com; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self "https://api.razorpay.com"), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Files whose names carry a hash of their content never change: keep them a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
