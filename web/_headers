# Response headers for the website on Cloudflare Pages. Copied into the build by
# .github/workflows/web-deploy.yml, which replaces SUPABASE_HOST with the project the build talks to.
#
# The page holds the sign-in session in the browser, so it runs no script but its own: no inline
# script, no eval, nothing from another origin. Styles may be inline because react-native-web
# writes its styles into the page. The only other place the page may talk to is Supabase
# (HTTPS for the API, WSS for Realtime).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://SUPABASE_HOST wss://SUPABASE_HOST; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Files whose names carry a hash of their content never change: keep them a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
